<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-strict-thymeleaf-4.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
	<head th:replace="header.thyme::head"/>
	<body onload="prettyPrint()">
	<div id="wrap">
		<div th:replace="menu.thyme::menu"/>
		<div class="container" style="max-width: 860px;">

			<div class="rpg-hero" style="padding: 30px; margin-bottom: 30px;">
				<h1 style="border-bottom: none; margin: 0;" th:text="'🏷️ Tag: '+${tag}">Tag: RPG</h1>
				<p class="lead" style="margin-bottom: 0;">Artigos e crônicas marcados com esta categoria.</p>
			</div>

			<div class="post-card">
				<h3 style="color: var(--accent-amber); margin-top: 0; margin-bottom: 20px; font-size: 1.3rem;">
					Postagens Marcadas com "<span th:text="${tag}">tag</span>"
				</h3>
				<ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
					<li th:each="post : ${tag_posts}" class="archive-list-item">
						<span class="archive-list-date" th:text="${#dates.format(post.date,'dd/MM/yyyy')}">01/09/2026</span>
						<a th:href="${content.rootpath + post.uri}" th:text="${post.title}" class="archive-list-title">Título do Post</a>
					</li>
				</ul>
			</div>

		</div>
	</div>

	<div th:replace="footer.thyme::footer"></div>
    </body>
</html>
