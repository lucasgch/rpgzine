# JBake Output
# ------------------------------------------------------------
# This is the default directory where JBake generates the static website.
# It should not be tracked since it is fully regenerated on every build.
output/

# Cache and Temporary Files
# ------------------------------------------------------------
# JBake uses a local database/cache to track changes and speed up baking.
.jbake/
*.log

# Operating System Files
# ------------------------------------------------------------
.DS_Store
Thumbs.db

# Build Tools (If you use Maven or Gradle to run JBake)
# ------------------------------------------------------------
# Gradle files
.gradle/
build/

# Maven files
target/

# IDE Configuration Files (Optional but recommended)
# ------------------------------------------------------------
.idea/
*.iml
.project
.classpath
.settings/
.vscode/

# Antigravity
.antigravity
.gemini
antigravity

