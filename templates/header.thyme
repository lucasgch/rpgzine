<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-transitional-thymeleaf-4.dtd">
<html lang="pt-BR">
	<head th:fragment="head">
	    <meta charset="utf-8"/>
	    <title th:text="${content != null and content.title != null ? content.title + ' - RPGZine' : 'RPGZine - Fanzine Digital'}"></title>
	    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	    <meta name="description" th:content="${content != null and content.get('description') != null ? content.get('description') : 'RPGZine - Um zine sobre RPG de mesa, filosofia OSR (Old School Renaissance), sistemas e assuntos relacionados.'}"/>
	    <meta name="author" content="RPGZine"/>
	    <meta name="keywords" content="rpg, osr, tabletop rpg, dnd, cairn, houserules, rpg de mesa"/>
	    <meta name="generator" content="JBake"/>

		<!-- Link Canônico -->
	    <link rel="canonical" th:if="${content != null and content.uri != null}" th:href="${config.site_host} + ${content.uri}" />

		<!-- Open Graph (Redes Sociais) -->
		<meta property="og:title" th:content="${content != null and content.title != null ? content.title : 'RPGZine'}" />
		<meta property="og:type" content="article" />
		<meta property="og:url" th:if="${content != null and content.uri != null}" th:href="${config.site_host} + ${content.uri}" />
		<meta property="og:description" th:content="${content != null and content.get('description') != null ? content.get('description') : 'RPGZine - Um zine sobre RPG de mesa, filosofia OSR (Old School Renaissance), sistemas e assuntos relacionados.'}" />
		<meta property="og:image" th:content="${content != null and content.get('image') != null ? 'https://www.lucasgodoy.dev' + content.get('image') : 'https://www.lucasgodoy.dev/rpgzine/img/imagem-padrao.png'}" />

		<!-- Twitter Cards (X e Bluesky) -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" th:content="${content != null and content.title != null ? content.title : 'RPGZine'}" />
		<meta name="twitter:description" th:content="${content != null and content.get('description') != null ? content.get('description') : 'RPGZine - Um zine sobre RPG de mesa, filosofia OSR (Old School Renaissance), sistemas e assuntos relacionados.'}" />
		<meta name="twitter:image" th:content="${content != null and content.get('image') != null ? 'https://www.lucasgodoy.dev' + content.get('image') : 'https://www.lucasgodoy.dev/rpgzine/img/imagem-padrao.png'}" />
		<meta name="twitter:card" content="summary_large_image" />
	
	    <!-- Stylesheets -->
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/bootstrap.min.css'" rel="stylesheet"/>
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/asciidoctor.css'" rel="stylesheet"/>
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/base.css'" rel="stylesheet"/>
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/prettify.css'" rel="stylesheet"/>
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" th:href="${rootpath}+'css/rpgzine.css'" rel="stylesheet"/>
	    <link rel="stylesheet" href="https://s.pageclip.co/v1/pageclip.css" media="screen"/>

		<!-- Tag de verificação do google search -->
		<meta name="google-site-verification" content="XuD14deA5t_DsQEoIxOjyaINCTxGkEgMtoigA3rNw-s" />
	
	    <!-- Fav and touch icons -->
	    <link th:with="rootpath=(${content != null and content.rootpath != null} ? ${content.rootpath} : '')" rel="shortcut icon" th:href="${rootpath}+'favicon.ico'"/>
	</head>
</html>