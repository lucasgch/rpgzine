<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-strict-thymeleaf-4.dtd">

<html lang="pt-BR" xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
	<body>
		<div th:fragment="footer">
			<div id="push"></div>
    
		    <div id="footer">
		      <div class="container">
		        <p class="muted credit">
		          &copy; 2026 <strong>RPGZine</strong> | Focado em RPG de Mesa | Inspirado na Filosofia Old School | 
		          Gerado com <a href="http://jbake.org" target="_blank" rel="noopener">JBake</a> &amp; <a href="https://www.thymeleaf.org/" target="_blank" rel="noopener">Thymeleaf</a>
		        </p>
		        <p class="muted credit">
		          <a href="https://www.flaticon.com/br/icones-gratis/rpg" title="rpg ícones" target="_blank" rel="noopener">Rpg ícones criados por David Carapinha - Flaticon</a>.
		        </p>
		      </div>
		    </div>
	    
		    <!-- Scripts Otimizados com defer -->
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/prettify.js'" defer="defer"></script>
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/dice-roller.js'" defer="defer"></script>
		    <script src="https://s.pageclip.co/v1/pageclip.js" charset="utf-8" defer="defer"></script>

		    <!-- Menu Mobile Toggle (Vanilla JS - Zero Dependências) -->
		    <script>
		      /*<![CDATA[*/
		      document.addEventListener('DOMContentLoaded', function () {
		        var toggle = document.querySelector('.navbar-toggle');
		        var collapse = document.querySelector('.navbar-collapse');
		        if (toggle && collapse) {
		          toggle.addEventListener('click', function () {
		            collapse.classList.toggle('in');
		            var expanded = collapse.classList.contains('in');
		            toggle.setAttribute('aria-expanded', expanded);
		          });
		        }
		      });
		      /*]]>*/
		    </script>
    
    	</div>
  	</body>
</html>
