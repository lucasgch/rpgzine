<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-strict-thymeleaf-4.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
	<body>
		<div th:fragment="footer">
			<div id="push"></div>
    
		    <div id="footer">
		      <div class="container">
		        <p class="muted credit">
		          &copy; 2026 <strong>RPGZine</strong> | Focado em RPG de Mesa | Inspirado na Filosofia Old School | 
		          Gerado com <a href="http://jbake.org" target="_blank" rel="noopener">JBake</a> &amp; <a href="https://www.thymeleaf.org/" target="_blank" rel="noopener">Thymeleaf</a>
		        </p>
		      </div>
		    </div>
	    
		    <!-- Scripts -->
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/jquery-1.11.1.min.js'"></script>
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/bootstrap.min.js'"></script>
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/prettify.js'"></script>
		    <script th:with="rootpath=(${content.rootpath != null} ? ${content.rootpath} : '')" th:src="${rootpath} + 'js/dice-roller.js'"></script>
		    <script src="https://s.pageclip.co/v1/pageclip.js" charset="utf-8"></script>
    
    	</div>
  	</body>
</html>