<!DOCTYPE html SYSTEM "http://www.thymeleaf.org/dtd/xhtml1-strict-thymeleaf-4.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
	<head th:replace="header.thyme::head"/>
	<body onload="prettyPrint()">
    <div id="wrap">
    	<div th:replace="menu.thyme::menu"/>
		<div class="container" style="max-width: 860px;">
			<div class="rpg-hero" style="padding: 30px; margin-bottom: 30px;">
				<h1 style="border-bottom: none; margin: 0;">Quests do RPGZine (Arquivo)</h1>
				<p class="lead" style="margin-bottom: 0;">Histórico completo de postagens e artigos publicados no RPGZine.</p>
			</div>
	
			<div class="post-card">
				<h3 style="color: var(--accent-amber); margin-top: 0; margin-bottom: 20px; font-size: 1.3rem;">
					Todas as Postagens
				</h3>
				<ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
					<li th:each="post : ${published_posts}" style="margin-bottom: 16px; font-size: 1.1rem; border-bottom: 1px dashed rgba(212, 175, 55, 0.2); padding-bottom: 12px; display: flex; align-items: center; gap: 15px;">
						<span style="color: var(--accent-gold); font-family: var(--font-sans); font-weight: 700; min-width: 100px;" th:text="${#dates.format(post.date,'dd/MM/yyyy')}">01/09/2026</span>
						<a th:href="${content.rootpath + post.uri}" th:text="${post.title}" style="font-size: 1.15rem; font-weight: 600;">Título do Post</a>
					</li>
				</ul>
			</div>

		</div>
	</div>
	
	<div th:replace="footer.thyme::footer"></div>
    </body>
</html>